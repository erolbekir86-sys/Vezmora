{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,docs/**,data/**,**/__pycache__/**,**/*.pyc,render.yaml,Dockerfile}"
    }
  },
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/static/privacy.html"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/cron/maintenance",
      "schedule": "0 7 * * *"
    }
  ]
}
