# Vexmera 0.6.1 Private Beta
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# App / session
# VEZMORA_* names are retained for backwards compatibility with the existing beta runtime.
VEZMORA_APP_URL=http://localhost:8000
VEZMORA_SECRET_KEY=
VEZMORA_COOKIE_SECURE=false
VEZMORA_DEV_SHOW_TOKENS=false

# Durable local beta storage
VEZMORA_DATA_DIR=.
# VEZMORA_DB_PATH=/absolute/path/vexmera.db

# Persistent production database (recommended on Vercel)
DATABASE_URL=
# POSTGRES_URL= may be used as an alternative when your provider exposes that name.
POSTGRES_URL=

# Legacy remote-store fallback. Leave blank when DATABASE_URL/POSTGRES_URL is used.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
VEZMORA_SERVERLESS=false
CRON_SECRET=

# Background automation
VEZMORA_ENABLE_WORKER=false
VEZMORA_ENABLE_SCHEDULER=false
VEZMORA_WORKER_POLL_SECONDS=5
VEZMORA_RIVAL_SCAN_HOURS=12

# External execution: keep both false throughout the private beta unless an
# explicitly reviewed production policy says otherwise.
VEZMORA_EXECUTION_ENABLED=false
VEZMORA_AUTOPILOT_EXECUTION_ENABLED=false

# Google OAuth + Ads
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connectors/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# Meta OAuth / Graph
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/connectors/meta/callback
META_GRAPH_VERSION=v24.0
VEZMORA_ENABLE_META_EXECUTION_SCOPE=false
# Bounded safety cap for read-only Insights pagination. 1-100; default 50.
VEZMORA_META_MAX_INSIGHTS_PAGES=50

# Stripe subscriptions — current public pricing model
# These price IDs MUST belong to the same Stripe account/mode as STRIPE_SECRET_KEY.
# Expected monthly SEK unit amounts before VAT:
#   Start = 99500 öre, Growth = 149500 öre, Pro = 299500 öre.
# Never reuse the historical Starter/Growth/Scale price IDs for this model.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# Keep blank until the Start/Growth/Pro Stripe sandbox catalog has been verified.
# Set exactly to 2026-09-start-growth-pro only after that verification succeeds.
VEZMORA_STRIPE_PRICING_VERSION=
VEZMORA_TRIAL_DAYS=14

# SMTP for invites and password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
