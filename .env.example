# Vezmora 0.6.1 Private Beta
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# App / session
VEZMORA_APP_URL=http://localhost:8000
VEZMORA_SECRET_KEY=
VEZMORA_COOKIE_SECURE=false
VEZMORA_DEV_SHOW_TOKENS=false

# Durable beta storage (use a persistent disk path in production)
VEZMORA_DATA_DIR=.
# VEZMORA_DB_PATH=/absolute/path/vezmora.db

# Serverless persistent database (recommended on Vercel)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
VEZMORA_SERVERLESS=false
CRON_SECRET=

# Background automation
VEZMORA_ENABLE_WORKER=false
VEZMORA_ENABLE_SCHEDULER=false
VEZMORA_WORKER_POLL_SECONDS=5
VEZMORA_RIVAL_SCAN_HOURS=12

# External execution: both must be enabled for autonomous execution.
VEZMORA_EXECUTION_ENABLED=false
VEZMORA_AUTOPILOT_EXECUTION_ENABLED=false

# Google OAuth + Ads
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connectors/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# Meta OAuth / Graph
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/connectors/meta/callback
META_GRAPH_VERSION=v24.0
VEZMORA_ENABLE_META_EXECUTION_SCOPE=false

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_1U82XoKROcXIKEHsjhbAapsJ
STRIPE_PRICE_GROWTH=price_1U82Y3KROcXIKEHstlk5ovOV
STRIPE_PRICE_SCALE=price_1U82YAKROcXIKEHssCxCmiWC
VEZMORA_TRIAL_DAYS=14

# SMTP for invites and password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
